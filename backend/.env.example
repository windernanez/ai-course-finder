# -----------------------------------------------------------------------------
# AI COURSE FINDER - CONFIGURACIÓN DE VARIABLES DE ENTORNO (Ejemplo)
# -----------------------------------------------------------------------------
# Copia este archivo como '.env' en la misma carpeta y rellena las claves.
# NO subas el archivo '.env' real a tu repositorio de Git.
# -----------------------------------------------------------------------------

# Configuración de Flask
SECRET_KEY=tu_clave_secreta_aqui
DEBUG=True

# API Keys (Indispensables)
GEMINI_API_KEY=tu_gemini_api_key_aqui
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# Configuración de Correo (Flask-Mail)
# Necesitas una 'Contraseña de Aplicación' si usas Gmail
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_aqui

# Google OAuth2 (Para login)
# Obtén estas en https://console.cloud.google.com/
GOOGLE_CLIENT_ID=tu_google_client_id_aqui
GOOGLE_CLIENT_SECRET=tu_google_client_secret_aqui
REDIRECT_URI=http://localhost:5000/callback

# Otras configuraciones
# PORT=5000
